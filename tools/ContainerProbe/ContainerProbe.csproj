<Project Sdk="Microsoft.NET.Sdk">
	<!-- Checks the capture code works inside the Steam runtime container Resonite's engine runs in. See README. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RollForward>LatestMajor</RollForward>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\..\LinuxNativeDesktop\Capture\**\*.cs" Link="Capture\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>
</Project>
